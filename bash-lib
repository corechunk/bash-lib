bl_file_count_feeder_() {
	local total=$1
	local hz=${2:-10}
	local dir="${3:-/tmp}"
	local pattern="${4:-*.done}"
	local finished=0
	local ms=$(( 1000 / hz ))
	local interval=$(printf "%d.%03d" $(( ms / 1000 )) $(( ms % 1000 )))
	while (( finished < total )); do
		local files=( "$dir"/$pattern )
		finished=${#files[@]}
		[[ -e "${files[0]}" ]] || finished=0
		echo "$finished"
		sleep "$interval"
	done
