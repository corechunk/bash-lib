#!/usr/bin/env bash

# --- Included: lib/async/pid.sh ---
declare -g -A BL_PIDS
bl_pid_store() {
	local name=$1
	local pid=$2
	BL_PIDS["$name"]="$pid"
}
bl_pid_wait() {
	local name=$1
	local pid="${BL_PIDS[$name]}"
	[[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && wait "$pid"
	unset "BL_PIDS[$name]"
}
bl_pid_status() {
	local pid="$1"
	if [[ -z "$pid" ]]; then
		echo "FAILED"
		return 1
	fi
	if kill -0 "$pid" 2>/dev/null; then
		echo "RUNNING"
		return 0
	fi
	wait "$pid" 2>/dev/null
	local ec=$?
	if (( ec == 0 || ec == 127 )); then
		echo "SUCCESS"
	else
		echo "FAILED"
	fi
	return $ec
}
bl_pid_reap() {
	for name in "${!BL_PIDS[@]}"; do
		local pid="${BL_PIDS[$name]}"
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid" 2>/dev/null
			unset "BL_PIDS[$name]"
		fi
	done
}

